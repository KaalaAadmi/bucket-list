# Copy to .env for `npm run dev`, and add the same values in Vercel → Project → Settings → Environment Variables.

# --- MongoDB Atlas. Use its own Atlas project (= its own free cluster), not Shot Listed's.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=r2_storage
# "memory" runs without a database (local trials only; forgets everything on restart).
STORE=mongo

# --- Cloudflare R2 (R2 → Manage API tokens → Create token, "Object Read & Write", this bucket only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shot-listed
# Only for an EU-jurisdiction bucket, or a local S3 mock (http://127.0.0.1:5055):
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com

# --- Secrets. Generate each with: openssl rand -hex 32
# Creates and revokes API keys (npm run create-key).
ADMIN_TOKEN=
# Vercel sends this to the daily cleanup. Set it in Vercel too.
CRON_SECRET=

# Shown in /v1/usage; R2's free tier is 10 GB.
FREE_TIER_BYTES=10737418240
